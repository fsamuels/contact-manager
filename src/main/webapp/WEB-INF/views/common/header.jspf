<%--
  Shared page header. Expects the including page to set the "pageTitle"
  variable via <c:set> before the include. Includes the top-bar Settings menu
  for switching UI themes (handled by resources/js/theme.js).
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> - Contact Manager</title>
    <script>
        // Apply the saved theme before the stylesheet loads so the page does
        // not flash the default theme. Must stay inline; theme names must
        // match the [data-theme] blocks in styles.css.
        (function () {
            var themes = ['light', 'dark', 'google', 'claude', 'facebook', 'alaska', 'reddit',
                'yahoo', 'wikipedia', 'amazon'];
            var theme = null;
            try {
                theme = window.localStorage.getItem('contactManagerTheme');
            } catch (ignored) {
                // Storage unavailable (e.g. blocked); fall through to default.
            }
            document.documentElement.setAttribute('data-theme',
                    themes.indexOf(theme) === -1 ? 'light' : theme);
        })();
    </script>
    <link rel="stylesheet" href="<c:url value='/resources/css/styles.css'/>">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>
</head>
<body>
<header class="site-header">
    <h1><a href="<c:url value='/persons'/>">Contact Manager</a></h1>
    <div class="config-menu">
        <button type="button" class="config-menu-button"
                aria-haspopup="true" aria-expanded="false">&#9881; Settings</button>
        <div class="config-menu-panel" hidden>
            <p class="config-menu-heading">Theme</p>
            <ul class="theme-list">
                <li><button type="button" class="theme-option" data-theme-option="light">Light Mode</button></li>
                <li><button type="button" class="theme-option" data-theme-option="dark">Dark Mode</button></li>
                <li><button type="button" class="theme-option" data-theme-option="google">Google</button></li>
                <li><button type="button" class="theme-option" data-theme-option="claude">Claude</button></li>
                <li><button type="button" class="theme-option" data-theme-option="facebook">Facebook</button></li>
                <li><button type="button" class="theme-option" data-theme-option="alaska">Alaska Airlines</button></li>
                <li><button type="button" class="theme-option" data-theme-option="reddit">Reddit</button></li>
                <li><button type="button" class="theme-option" data-theme-option="yahoo">Yahoo</button></li>
                <li><button type="button" class="theme-option" data-theme-option="wikipedia">Wikipedia</button></li>
                <li><button type="button" class="theme-option" data-theme-option="amazon">Amazon</button></li>
            </ul>
        </div>
    </div>
</header>
<main class="content">
